  m_Script: {fileID: 11500000, guid: b59e5109641be024fb790db23ec12cf0, type: 3}
  m_Name: Radio
  m_EditorClassIdentifier: 
  sentences:
  - text: "\u201CIci La BBC Home Service, nous interrompons momentan\xE9ment notre
      programme pour une information de derni\xE8re minute. Le corps d\u2019une femme
      a \xE9t\xE9 retrouv\xE9 ce matin au manoir Warner House, le lendemain de leur
      soir\xE9e d\u2019inauguration. La victime n\u2019a pas encore \xE9t\xE9 identifi\xE9
      et son meurtrier court toujours. La police a \xE9t\xE9 appel\xE9 sur les lieux
      du crime apr\xE8s la d\xE9couverte du corps\u201D"
    speaker: {fileID: 11400000, guid: 4d96f2b7e8edf4949811cea01149a3f1, type: 2}
