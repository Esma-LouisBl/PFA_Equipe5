  m_Name: "Demenag\xE9"
  m_EditorClassIdentifier: 
  sentences:
  - text: "Ils ont d\xE9m\xE9nag\xE9. "
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "D\xE9m\xE9nag\xE9 durant leur d\xE9placement\u202F?"
    speaker: {fileID: 11400000, guid: a70d6988c421ce943bbf9815b7ae3f56, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "\u2026 J\u2019ai d\xFB me tromper. "
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Ce n\u2019est rien, \xE7a fait longtemps aussi que tu n\u2019as pas \xE9t\xE9
      sur une enqu\xEAte. "
    speaker: {fileID: 11400000, guid: e7a68b2376e53284bb4ce3103615c962, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: 'il faut que je relise mes notes plus souvent. '
    speaker: {fileID: 0}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
