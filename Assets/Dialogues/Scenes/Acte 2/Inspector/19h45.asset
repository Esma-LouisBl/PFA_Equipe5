  sentences:
  - text: 19h45.
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Ah bon\u202F? \xC7a ne colle pas pourtant, le meurtre a eu lieu avant
      cet horaire donc que ferait la victime dans le bureau de Monsieur Warner ? "
    speaker: {fileID: 11400000, guid: 94f552401d853464eba92c33f32b25fd, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Elle voulait peut-\xEAtre pr\xE9parer son interview\u202F? "
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "\xC7a m\u2019\xE9tonnerait qu\u2019elle ait pu entrer dans son bureau
      sans soucis. "
    speaker: {fileID: 11400000, guid: a70d6988c421ce943bbf9815b7ae3f56, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Mince, j\u2019ai d\xFB me tromper."
    speaker: {fileID: 0}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
