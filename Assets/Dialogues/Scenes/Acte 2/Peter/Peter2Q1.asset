  m_Name: Peter2Q1
  m_EditorClassIdentifier: 
  sentences:
  - text: "J\u2019ai pu \xE9changer avec madame Marie qui m\u2019a parl\xE9 de votre
      pass\xE9 commun. "
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: '...Je ne pensais pas qu''elle vous en parlerait. '
    speaker: {fileID: 11400000, guid: 01c793bd5695150458beb223b0ca19d1, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Nous avons eu une aventure ensemble mais cela fait plusieurs ann\xE9es
      que je ne l\u2019avais pas revue. "
    speaker: {fileID: 11400000, guid: fe83f170e3888fb4b9d1a90293d70ad1, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Avant mon interview, elle est venue \xE0 moi en me disant vouloir discuter.
      Nous avons un peu convers\xE9 puis elle a quitt\xE9 mes appartements.  "
    speaker: {fileID: 11400000, guid: fe83f170e3888fb4b9d1a90293d70ad1, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  background: {fileID: 0}
  nextScene: {fileID: 11400000, guid: 3f84c3dbd021498479795300fbabc67a, type: 2}
