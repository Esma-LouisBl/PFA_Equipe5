  m_Script: {fileID: 11500000, guid: b59e5109641be024fb790db23ec12cf0, type: 3}
  m_Name: HollyCall
  m_EditorClassIdentifier: 
  sentences:
  - text: "Qui est la personne qui accapare mon pr\xE9cieux temps ? "
    speaker: {fileID: 11400000, guid: 9b70230fa44baea4a809b06cb0790bc5, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 1
    hideSprite: 0
  - text: 'Bonjour Madame, je suis le majordome de ce manoir, Monsieur Edwin Justice. '
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Je ne crois pas vous avoir demand\xE9 votre nom, je me trompe ? Que me
      voulez-vous ?"
    speaker: {fileID: 11400000, guid: 9b70230fa44baea4a809b06cb0790bc5, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Comme vous le savez s\xFBrement, il y a eu un meurtre durant la soir\xE9e.
      J\u2019aurais besoin de vous poser plusieurs questions \xE0 ce sujet."
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Oh ciel, je n\u2019\xE9tais point au courant de ce drame ! Soit, faites
      vite, j\u2019ai beaucoup \xE0 faire."
    speaker: {fileID: 11400000, guid: 8c8d0a0c7222fe74f9da285981bc475b, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
