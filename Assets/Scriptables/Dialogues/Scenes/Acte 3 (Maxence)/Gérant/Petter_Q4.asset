  sentences:
  - text: Connaissez-vous un certain Oliver Scott ?
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Je crois bien oui, n\u2019est-il pas journaliste ?"
    speaker: {fileID: 11400000, guid: 80fc6151c1a269d4fbe227d2353da448, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Oui, il s\u2019agit d\u2019un des journalistes convi\xE9s \xE0 la soir\xE9e.
      Aviez-vous discut\xE9 avec lui\u202F?"
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    showSprite: 0
    hideSprite: 0
  - text: "Oui, il m\u2019avait demand\xE9 une interview un peu apr\xE8s Madame Brown
      mais j\u2019\xE9tais d\xE9j\xE0 pris pour la soir\xE9e."
    speaker: {fileID: 11400000, guid: 80fc6151c1a269d4fbe227d2353da448, type: 2}
