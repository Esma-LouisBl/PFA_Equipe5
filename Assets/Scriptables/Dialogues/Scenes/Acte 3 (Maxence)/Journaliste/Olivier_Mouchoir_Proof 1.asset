  sentences:
  - text: "Qu\u2019est-ce que c\u2019est que ce mouchoir\u202F?"
    speaker: {fileID: 11400000, guid: c1ea30fb2f07ec84382ca382ddb38ca8, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
