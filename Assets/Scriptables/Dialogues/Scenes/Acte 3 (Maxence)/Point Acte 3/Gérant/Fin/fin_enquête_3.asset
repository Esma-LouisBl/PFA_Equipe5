%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b59e5109641be024fb790db23ec12cf0, type: 3}
  m_Name: "fin_enqu\xEAte_3"
  m_EditorClassIdentifier: 
  sentences:
  - text: Ahhhh
    speaker: {fileID: 11400000, guid: f2e3f60cc6c47c141970981cc997e513, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "\xC7a fait du bien de clore une enqu\xEAte, pas vrai ?"
    speaker: {fileID: 11400000, guid: 91c12d8a854297743ae6bd570bce8650, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 1
    hideSprite: 0
    destroyEvidence: 0
  - text: "Disons que c\u2019est\u2026 particulier. On parle de mon patron, apr\xE8s
      tout. Difficile de savoir ce que je ressens."
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "A-t-il fini par avouer les faits\u202F? "
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Pas du tout. Il nie tout en bloc. Mais avec les preuves et les t\xE9moignages\u2026
      il risque bien la perp\xE9tuit\xE9."
    speaker: {fileID: 11400000, guid: b2b59167c301014478be887406d38a18, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Ses avocats vont s\xFBrement adoucir la peine. Vous pensez pouvoir tenir
      la maison sans lui ? "
    speaker: {fileID: 11400000, guid: b2b59167c301014478be887406d38a18, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Ne t\u2019en fais pas. On tiendra le manoir, le temps que Monsieur Warner
      paie sa dette."
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Et s\u2019il n\u2019y parvient pas\u2026 eh bien, peut-\xEAtre serons-nous
      envoy\xE9s servir les autres branches de la famille. Qui sait ce que l\u2019avenir
      nous r\xE9serve ?"
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Bon \xE9tat d\u2019esprit."
    speaker: {fileID: 11400000, guid: b2b59167c301014478be887406d38a18, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Enfin\u2026 ne parlons plus de cette affaire. C\u2019est termin\xE9."
    speaker: {fileID: 11400000, guid: 91c12d8a854297743ae6bd570bce8650, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Certains pr\xE9f\xE8rent garder le silence."
    speaker: {fileID: 11400000, guid: 91c12d8a854297743ae6bd570bce8650, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Et parfois\u2026 c\u2019est mieux ainsi. L\u2019affaire est close."
    speaker: {fileID: 11400000, guid: d01bd033cdae78b45b5edff30c498259, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  background: {fileID: 0}
  nextScene: {fileID: 0}
  conditionScene: {fileID: 0}
  conditionToUnlock: []
  callInspector: 0
  endInspector: 0
  blackScreen: 0
