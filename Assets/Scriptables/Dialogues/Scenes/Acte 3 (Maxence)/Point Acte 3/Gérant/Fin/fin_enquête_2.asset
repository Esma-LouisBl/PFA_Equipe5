  m_Script: {fileID: 11500000, guid: b59e5109641be024fb790db23ec12cf0, type: 3}
  m_Name: "fin_enqu\xEAte_2"
  m_EditorClassIdentifier: 
  sentences:
  - text: "\xAB \u2026 Le coupable serait Peter Warner, l\u2019organisateur de la
      soir\xE9e. Il a \xE9t\xE9 arr\xEAt\xE9 ce matin. \xBB"
    speaker: {fileID: 11400000, guid: 7f24d978b6e625e48ba9626a1a59dcc2, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 1
    destroyEvidence: 0
  - text: "(Monsieur Warner, arr\xEAt\xE9... Quelle chute. On nous a tous cong\xE9di\xE9s,
      en attendant que la famille d\xE9cide de l\u2019avenir de l\u2019entreprise.
      )"
    speaker: {fileID: 11400000, guid: 0d691f116a18cfd43b72ba0e77721004, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "(J\u2019ai vou\xE9 ma loyaut\xE9 \xE0 un homme que j\u2019ai d\xFB livrer
      aux autorit\xE9s... \xC9tait-ce une erreur de vouloir tourner la page ?)"
    speaker: {fileID: 11400000, guid: 0d691f116a18cfd43b72ba0e77721004, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 1
    destroyEvidence: 0
  - text: Toc-toc
    speaker: {fileID: 11400000, guid: 0d691f116a18cfd43b72ba0e77721004, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 1
    destroyEvidence: 0
  - text: "Edwin ? C\u2019est moi. Tu es l\xE0 ?"
    speaker: {fileID: 11400000, guid: f2e3f60cc6c47c141970981cc997e513, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 1
    destroyEvidence: 0
  - text: "J\u2019arrive."
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
