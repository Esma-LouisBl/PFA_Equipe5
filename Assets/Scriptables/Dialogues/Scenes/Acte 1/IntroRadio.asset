    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Le corps d\u2019une femme a \xE9t\xE9 retrouv\xE9 plus t\xF4t dans la
      matin\xE9e au manoir Warner House."
    speaker: {fileID: 11400000, guid: 7f24d978b6e625e48ba9626a1a59dcc2, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
