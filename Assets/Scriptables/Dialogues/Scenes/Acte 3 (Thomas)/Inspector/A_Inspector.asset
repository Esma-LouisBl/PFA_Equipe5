    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "...Tu n\u2019as pas tort, j\u2019ai d\xFB confondre. "
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: 'Avec toutes tes notes tu en perds le fil, mon pauvre ! '
