    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "C'est vrai mais elle aurait tr\xE8s bien pu le perdre avant le meurtre. "
