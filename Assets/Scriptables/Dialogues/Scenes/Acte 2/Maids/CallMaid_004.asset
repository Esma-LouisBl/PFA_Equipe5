  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b59e5109641be024fb790db23ec12cf0, type: 3}
  m_Name: CallMaid_004
  m_EditorClassIdentifier: 
  sentences:
  - text: "Me revoil\xE0, j\u2019ai pu discuter avec chacune d'entre d\u2019elles
      et il y aurait eu un journaliste qui \xE9coutait \xE0 la porte du bureau de
      Monsieur Warner. "
    speaker: {fileID: 11400000, guid: bd895e725e3919943846e588674f3505, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Le cuisinier m\u2019a aussi inform\xE9 qu\u2019il voudrait s\u2019entretenir
      avec vous quand vous aurez le temps, il aurait quelque chose pour l\u2019enqu\xEAte. "
    speaker: {fileID: 11400000, guid: bd895e725e3919943846e588674f3505, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "(Vraiment ? Mais il n\u2019\xE9tait pas \xE0 la soir\xE9e ?)"
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Merci pour cette information, dites-lui que je le joindrais d\xE8s que
      possible. "
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: 'Ce sera fait en temps et en heure, Monsieur. '
    speaker: {fileID: 11400000, guid: bd895e725e3919943846e588674f3505, type: 2}
    collectedCondition: 
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  - text: "Tr\xE8s bien. Et si vous avez du nouveau, tenez-moi au courant. "
    speaker: {fileID: 11400000, guid: 10e726bdc8934bb42b9ea78a54dd1aa3, type: 2}
    collectedCondition: Maid
    testimony: {fileID: 0}
    suspect: {fileID: 0}
    phoneContact: {fileID: 0}
    contactToRemove: {fileID: 0}
    evidence: {fileID: 0}
    inspectorSceneToCollect: {fileID: 0}
    photoFrame: {fileID: 0}
    showSprite: 0
    hideSprite: 0
    destroyEvidence: 0
  background: {fileID: 0}
